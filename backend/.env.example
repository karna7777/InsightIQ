# Copy to `.env` and adjust as needed. All values have local defaults, so an
# empty/absent .env works fine for step 1 (Groq is unused until step 3).

# Where the local DuckDB file lives (holds row data + app metadata).
# Default: backend/data/insightiq.duckdb
# INSIGHTIQ_DB_PATH=./data/insightiq.duckdb

# Server port (default 8000).
# INSIGHTIQ_PORT=8000

# Comma-separated allowed CORS origins (the Next.js frontend, step 2).
# INSIGHTIQ_CORS_ORIGINS=http://localhost:3000

# Groq API key — required from step 3 onward, unused now.
# GROQ_API_KEY=
